{
  "schemaVersion": 1,
  "id": "confined-.ember",
  "name": "Ember-Tray",
  "version": "1.0.0",
  "author": "Confined",
  "license": "MIT",
  "description": "Monitor and control an Ember smart mug from the tray: current temperature, battery level, and target temperature.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Ember-Tray",
    "description": "Current temperature, battery level, and target temperature control for an Ember smart mug — lives in your tray.",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "mac": "",
      "pollIntervalSec": 10,
      "unit": "",
      "refreshOnOpen": true
    },
    "schema": [
      {
        "key": "mac",
        "type": "string",
        "label": "Mug MAC address (AA:BB:CC:DD:EE:FF)",
        "defaultValue": ""
      },
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "unit",
        "type": "string",
        "label": "Display unit (C or F; empty uses the mug's own setting)",
        "defaultValue": ""
      },
      {
        "key": "refreshOnOpen",
        "type": "boolean",
        "label": "Refresh when the panel opens",
        "defaultValue": true
      }
    ]
  }
}